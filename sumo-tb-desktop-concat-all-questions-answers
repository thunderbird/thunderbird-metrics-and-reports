#!/usr/bin/env python3
import sys
import os
import glob
import pandas as pd
from datetime import datetime, timezone

if len(sys.argv) == 3:
    year = int(sys.argv[1])
    month = int(sys.argv[2])
else:
    now = datetime.now(timezone.utc)
    year = now.year
    month = now.month

# Per-day CSVs produced by the aaq-scraper (https://github.com/thunderbird/aaq-scraper),
# copied locally into aaq-data/<year>/. Filenames:
#   questions-thunderbird-desktop-YYYY-MM-DD.csv
#   answers-thunderbird-desktop-YYYY-MM-DD.csv
data_dir = 'aaq-data'

# Ensure CONCATENATED_FILES exists
os.makedirs('CONCATENATED_FILES/DESKTOP', exist_ok=True)

def concat_files(files, dedup_key, sort_key, output_file):
    if not files:
        print(f"No files found for {output_file}")
        return
    dfs = [pd.read_csv(f) for f in files]
    combined = pd.concat(dfs, ignore_index=True)
    combined = combined.drop_duplicates(subset=dedup_key, keep='last')
    combined = combined.sort_values(sort_key)
    combined.to_csv(output_file, index=False)
    print(f"Created {output_file} ({len(combined)} rows from {len(files)} daily files)")

# Concatenate every daily file for the requested month into a single monthly CSV
# matching the historical schema/filenames the downstream report scripts expect.
# All columns (incl. operating_system / thunderbird_version) are preserved.
questions_files = sorted(glob.glob(f'{data_dir}/{year}/questions-thunderbird-desktop-{year}-{month:02d}-*.csv'))
concat_files(questions_files, 'id', 'id', f'CONCATENATED_FILES/DESKTOP/{year}-{month:02d}-sumo-desktop-questions.csv')

answers_files = sorted(glob.glob(f'{data_dir}/{year}/answers-thunderbird-desktop-{year}-{month:02d}-*.csv'))
concat_files(answers_files, 'id', 'question_id', f'CONCATENATED_FILES/DESKTOP/{year}-{month:02d}-sumo-desktop-answers.csv')
